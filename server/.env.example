# ────────────────────────────────────────────────────────────────
# F.A.I. server environment
# Copy to `.env` and fill in the values.
# NEVER commit `.env` to the repository.
# ────────────────────────────────────────────────────────────────

# Node environment: development | test | production
NODE_ENV=development

# Port and host the server binds to (Railway/Render/Fly inject PORT automatically)
PORT=4000
HOST=0.0.0.0

# ── Google Gemini ──────────────────────────────────────────────
# Get a free key: https://aistudio.google.com/apikey
# This key lives ONLY on the server. It is never sent to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.6
GEMINI_MAX_TOKENS=1024
GEMINI_TIMEOUT_MS=60000

# ── CORS ───────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash).
# In production, add your deployed portfolio URL (e.g. https://fatma.example.com)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ── Rate limiting ──────────────────────────────────────────────
# Maximum requests per IP per window
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000

# ── Trust proxy ────────────────────────────────────────────────
# Set to 1 when behind a reverse proxy (Railway, Render, Fly.io, Nginx).
# Needed so rate limiting sees the real client IP.
TRUST_PROXY=1

# ── Logging ────────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
