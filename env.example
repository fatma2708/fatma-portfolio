# ────────────────────────────────────────────────────────────────
# Frontend (CRA) environment
# Copy to `.env` and fill in the values. NEVER commit `.env`.
# ────────────────────────────────────────────────────────────────

# F.A.I. chatbot — backend URL (the Groq key lives ONLY in server/.env).
# In dev, the F.A.I. server runs on port 4000 (`npm run dev` inside server/).
# In production, set this to your deployed backend URL (e.g. the Railway
# service URL). This value is baked into the bundle at build time, so it
# must be set as a build-time env var on Vercel.
REACT_APP_FAI_API_URL=http://localhost:4000

# ── Optional: GitHub / Medium data (legacy template sections) ──
# Only needed if you use the GitHub-profile / Medium-blog template sections.
# The FATMA OS app does not require these.
REACT_APP_GITHUB_TOKEN=
GITHUB_USERNAME=
USE_GITHUB_DATA=false
MEDIUM_USERNAME=
